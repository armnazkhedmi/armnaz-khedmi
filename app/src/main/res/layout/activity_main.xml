<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F9"
    android:layoutDirection="rtl">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ========================= -->
            <!-- الرأس الرئيسي -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="24dp"
                android:background="#176B87">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="أهلاً بك 👋"
                            android:textColor="#DDF3F7"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="أرمناز الخدمي"
                            android:textColor="#FFFFFF"
                            android:textSize="29sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#125A71">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="🏘️"
                            android:textSize="25sp"/>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="كل ما تحتاجه في أرمناز، في مكان واحد."
                    android:textColor="#E5F5F8"
                    android:textSize="14sp"/>

            </LinearLayout>


            <!-- ========================= -->
            <!-- المحتوى -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- الطقس والصلاة -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="125dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌤️"
                                android:textSize="28sp"/>

                            <TextView
                                android:id="@+id/weatherCard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:layout_marginTop="5dp"
                                android:text="الطقس\n--°"
                                android:textColor="#17232B"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp"/>


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="125dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🕌"
                                android:textSize="28sp"/>

                            <TextView
                                android:id="@+id/prayerCard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:layout_marginTop="5dp"
                                android:text="الصلاة\nالفجر --"
                                android:textColor="#17232B"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- تحديث -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E4F2F5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="↻"
                            android:textColor="#176B87"
                            android:textSize="25sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="تحديث البيانات"
                            android:textColor="#176B87"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تحديث الآن  ›"
                            android:textColor="#176B87"
                            android:textSize="13sp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- العنوان -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ماذا تحتاج اليوم؟"
                            android:textColor="#17232B"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="اختر الخدمة التي تريدها بسرعة"
                            android:textColor="#71808A"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الكل"
                        android:textColor="#176B87"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- شبكة الخدمات -->

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:columnCount="2"
                    android:useDefaultMargins="false">


                    <!-- الطوارئ -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnEmergency"
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#FFF0F0"
                                android:text="🚨"
                                android:textSize="24sp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="الطوارئ"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="مساعدة سريعة"
                                android:textColor="#71808A"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- الصرف -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnExchange"
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#EEF7FF"
                                android:text="💱"
                                android:textSize="24sp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="أسعار الصرف"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="أسعار العملات"
                                android:textColor="#71808A"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- الصيدليات -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPharmacy"
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#EFFAF4"
                                android:text="💊"
                                android:textSize="24sp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="الصيدليات"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="دليل الصيدليات"
                                android:textColor="#71808A"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- المياه -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnWater"
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#EDF9FF"
                                android:text="🚰"
                                android:textSize="24sp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="دور المياه"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="مواقع ونقاط المياه"
                                android:textColor="#71808A"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- الوفيات -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnDeaths"
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#F4F2F7"
                                android:text="🕊️"
                                android:textSize="24sp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="الوفيات والعزاء"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="آخر الإعلانات"
                                android:textColor="#71808A"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- التنبيهات -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAlerts"
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#FFF7E8"
                                android:text="📢"
                                android:textSize="24sp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="التنبيهات"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="آخر الأخبار المهمة"
                                android:textColor="#71808A"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>


                <!-- آخر تحديث -->

                <TextView
                    android:id="@+id/lastUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="آخر تحديث: لم يتم التحديث بعد"
                    android:textColor="#87949C"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- التنقل السفلي -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂\nالرئيسية"
                android:textColor="#176B87"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/navEmergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🚨\nالطوارئ"
                android:textColor="#71808A"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/navServices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🧰\nالخدمات"
                android:textColor="#71808A"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/navExchange"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="💱\nالصرف"
                android:textColor="#71808A"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙️\nالإعدادات"
                android:textColor="#71808A"
                android:textSize="12sp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
