<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أرمناز الخدمي"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="معلومتك الخدمية في مكان واحد"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#E6F2F5"
            android:text="● متصل — البيانات جاهزة للتحديث"
            android:textSize="14sp"
            android:textColor="@color/primary_dark"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FFFFFF"
                android:text="🌤️&#10;الطقس&#10;--°"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FFFFFF"
                android:text="🕌&#10;مواقيت الصلاة&#10;الفجر --"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="@color/danger"
            android:text="🚨  مركز الطوارئ"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="الإسعاف"
            android:textSize="17sp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="الدفاع المدني"
            android:textSize="17sp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="الشرطة"
            android:textSize="17sp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="طوارئ الكهرباء"
            android:textSize="17sp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="المشفى والعيادات"
            android:textSize="17sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:text="💱  أسعار الصرف&#10;&#10;الدولار / الليرة السورية: --&#10;الليرة التركية / الليرة السورية: --&#10;الدولار / الليرة التركية: --&#10;&#10;آخر تحديث: لا توجد بيانات"
            android:textSize="17sp"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:text="💊  الصيدلية المناوبة&#10;&#10;اسم الصيدلي: --&#10;الهاتف: --&#10;الحالة: لا توجد بيانات"
            android:textSize="17sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:text="🚰  دور المياه في أرمناز&#10;&#10;سيتم عرض الأماكن المفتوحة حاليًا."
            android:textSize="17sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:text="📢  التنبيهات الخدمية&#10;&#10;لا توجد تنبيهات حاليًا."
            android:textSize="17sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="#E7E7E7"
            android:text="🕊️  الوفيات والعزاء&#10;&#10;لا توجد بطاقة عزاء فعالة حاليًا."
            android:textSize="17sp"/>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:text="🔄 تحديث البيانات"
            android:textSize="17sp"/>

    </LinearLayout>

</ScrollView>
