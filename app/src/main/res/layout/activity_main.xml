<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:layoutDirection="rtl">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="82dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="24dp"
                android:background="#176B87">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مرحبًا بك"
                            android:textColor="#CDEBF0"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="أرمناز الخدمي"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            android:tint="#176B87"
                            android:contentDescription="أرمناز"/>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="خدمات ومعلومات أرمناز في مكان واحد"
                    android:textColor="#E2F4F7"
                    android:textSize="14sp"/>

            </LinearLayout>


            <!-- ========================= -->
            <!-- CONTENT -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp">


                <!-- ========================= -->
                <!-- WEATHER + PRAYER -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5EAED"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:padding="10dp"
                                android:background="#EAF6F8"
                                android:src="@android:drawable/ic_menu_day"
                                android:tint="#176B87"
                                android:contentDescription="الطقس"/>

                            <TextView
                                android:id="@+id/weatherCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="الطقس&#10;--°"
                                android:textColor="#18262D"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5EAED"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:padding="10dp"
                                android:background="#EEF1F8"
                                android:src="@android:drawable/ic_menu_recent_history"
                                android:tint="#526B91"
                                android:contentDescription="الصلاة"/>

                            <TextView
                                android:id="@+id/prayerCard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="الصلاة&#10;الفجر --"
                                android:textColor="#18262D"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ========================= -->
                <!-- REFRESH -->
                <!-- ========================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E9F5F7"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="10dp"
                            android:background="#D5EBEF"
                            android:src="@android:drawable/ic_popup_sync"
                            android:tint="#176B87"
                            android:contentDescription="تحديث"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="11dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="تحديث البيانات"
                                android:textColor="#176B87"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="تحديث المعلومات المتاحة"
                                android:textColor="#71818A"
                                android:textSize="12sp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تحديث"
                            android:textColor="#176B87"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================= -->
                <!-- SECTION TITLE -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="الخدمات"
                            android:textColor="#18262D"
                            android:textSize="23sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="اختر ما تحتاجه بسرعة"
                            android:textColor="#7A878E"
                            android:textSize="13sp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- ========================= -->
                <!-- SERVICES GRID -->
                <!-- ========================= -->

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="2"
                    android:useDefaultMargins="false">


                    <!-- EMERGENCY -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnEmergency"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E9E4E4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:padding="11dp"
                                android:background="#FFF0F0"
                                android:src="@android:drawable/ic_dialog_alert"
                                android:tint="#C94C4C"
                                android:contentDescription="الطوارئ"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="الطوارئ"
                                android:textColor="#18262D"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="مساعدة عاجلة"
                                android:textColor="#7A878E"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- EXCHANGE -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnExchange"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E1E9ED">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:padding="11dp"
                                android:background="#EAF5F8"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                android:tint="#176B87"
                                android:contentDescription="أسعار الصرف"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="أسعار الصرف"
                                android:textColor="#18262D"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="عملات وذهب وفضة"
                                android:textColor="#7A878E"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- PHARMACY -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPharmacy"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E1E9E4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:padding="11dp"
                                android:background="#EAF7F1"
                                android:src="@android:drawable/ic_menu_help"
                                android:tint="#328261"
                                android:contentDescription="الصيدليات"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="الصيدليات"
                                android:textColor="#18262D"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="دليل الصيدليات"
                                android:textColor="#7A878E"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- WATER -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnWater"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFE9ED">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:padding="11dp"
                                android:background="#EAF7FB"
                                android:src="@android:drawable/ic_menu_compass"
                                android:tint="#328AA3"
                                android:contentDescription="دور المياه"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="دور المياه"
                                android:textColor="#18262D"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="مواعيد وأدوار الضخ"
                                android:textColor="#7A878E"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- DEATHS -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnDeaths"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5E2E8">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:padding="11dp"
                                android:background="#F1EFF4"
                                android:src="@android:drawable/ic_menu_info_details"
                                android:tint="#6C6278"
                                android:contentDescription="الوفيات والعزاء"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="الوفيات والعزاء"
                                android:textColor="#18262D"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="آخر الإعلانات"
                                android:textColor="#7A878E"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- ALERTS -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAlerts"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E9E4D9">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:padding="11dp"
                                android:background="#FFF6E8"
                                android:src="@android:drawable/ic_dialog_info"
                                android:tint="#B47A29"
                                android:contentDescription="التنبيهات"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="التنبيهات"
                                android:textColor="#18262D"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="أخبار وتنبيهات مهمة"
                                android:textColor="#7A878E"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>


                <!-- ========================= -->
                <!-- LAST UPDATE -->
                <!-- ========================= -->

                <TextView
                    android:id="@+id/lastUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="آخر تحديث: لم يتم التحديث بعد"
                    android:textColor="#8B979D"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="26dp"
        app:cardElevation="9dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#E7EBED">

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂&#10;الرئيسية"
                android:textColor="#176B87"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/navEmergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="!&#10;الطوارئ"
                android:textColor="#7C898F"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/navServices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="＋&#10;الخدمات"
                android:textColor="#7C898F"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/navExchange"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="$&#10;الصرف"
                android:textColor="#7C898F"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙&#10;الإعدادات"
                android:textColor="#7C898F"
                android:textSize="11sp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
