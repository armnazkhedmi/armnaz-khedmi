<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:layoutDirection="rtl">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="78dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================= -->
            <!-- الرأس -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="26dp"
                android:background="#125A71">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="أهلاً بك"
                            android:textColor="#BFE4EA"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="أرمناز الخدمي"
                            android:textColor="#FFFFFF"
                            android:textSize="29sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#176B87">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="⌂"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold"/>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="كل ما تحتاجه في أرمناز، في مكان واحد."
                    android:textColor="#D8EFF3"
                    android:textSize="14sp"/>

            </LinearLayout>


            <!-- ========================= -->
            <!-- المحتوى -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp">


                <!-- ========================= -->
                <!-- الطقس والصلاة -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="118dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5EAED">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:background="#EAF6F8"
                                android:text="☀"
                                android:textColor="#176B87"
                                android:textSize="25sp"/>

                            <TextView
                                android:id="@+id/weatherCard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:gravity="center"
                                android:text="الطقس&#10;--°"
                                android:textColor="#17232B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp"/>


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="118dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5EAED">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:background="#F0ECFA"
                                android:text="◐"
                                android:textColor="#62518A"
                                android:textSize="25sp"/>

                            <TextView
                                android:id="@+id/prayerCard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:gravity="center"
                                android:text="الصلاة&#10;الفجر --"
                                android:textColor="#17232B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ========================= -->
                <!-- تحديث البيانات -->
                <!-- ========================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E5F3F5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:background="#D2EBEF"
                            android:text="↻"
                            android:textColor="#176B87"
                            android:textSize="25sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="11dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="تحديث البيانات"
                                android:textColor="#176B87"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="احصل على آخر المعلومات"
                                android:textColor="#6D7C84"
                                android:textSize="12sp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تحديث  ›"
                            android:textColor="#176B87"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================= -->
                <!-- عنوان الخدمات -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ماذا تحتاج اليوم؟"
                            android:textColor="#17232B"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="خدمات أرمناز بين يديك"
                            android:textColor="#75838B"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الخدمات"
                        android:textColor="#176B87"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- ========================= -->
                <!-- شبكة الخدمات -->
                <!-- ========================= -->

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:columnCount="2"
                    android:useDefaultMargins="false">


                    <!-- الطوارئ -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnEmergency"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E9E1E1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#FFF0F0"
                                android:text="!"
                                android:textColor="#D94B4B"
                                android:textSize="25sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="الطوارئ"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="مساعدة سريعة"
                                android:textColor="#75838B"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- الصرف -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnExchange"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E1E9EE">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#EAF5FA"
                                android:text="$"
                                android:textColor="#176B87"
                                android:textSize="22sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="أسعار الصرف"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="العملات والذهب والفضة"
                                android:textColor="#75838B"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- الصيدليات -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPharmacy"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E1EAE4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#EAF7F0"
                                android:text="+"
                                android:textColor="#2C8B62"
                                android:textSize="27sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="الصيدليات"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="دليل الصيدليات"
                                android:textColor="#75838B"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- المياه -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnWater"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DDEBF0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#E9F7FB"
                                android:text="≈"
                                android:textColor="#2587A3"
                                android:textSize="26sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="دور المياه"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="دور الضخ والحارات"
                                android:textColor="#75838B"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- الوفيات -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnDeaths"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E6E2EA">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#F2EFF6"
                                android:text="○"
                                android:textColor="#71637F"
                                android:textSize="26sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="الوفيات والعزاء"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="آخر الإعلانات"
                                android:textColor="#75838B"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- التنبيهات -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAlerts"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#EEE7D8">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:background="#FFF6E5"
                                android:text="!"
                                android:textColor="#C58A2A"
                                android:textSize="25sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:text="التنبيهات"
                                android:textColor="#17232B"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="آخر الأخبار المهمة"
                                android:textColor="#75838B"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>


                <!-- ========================= -->
                <!-- آخر تحديث -->
                <!-- ========================= -->

                <TextView
                    android:id="@+id/lastUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="آخر تحديث: لم يتم التحديث بعد"
                    android:textColor="#89969D"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- التنقل السفلي -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="26dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂&#10;الرئيسية"
                android:textColor="#176B87"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/navEmergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="!&#10;الطوارئ"
                android:textColor="#7A878E"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/navServices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="＋&#10;الخدمات"
                android:textColor="#7A878E"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/navExchange"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="$&#10;الصرف"
                android:textColor="#7A878E"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙&#10;الإعدادات"
                android:textColor="#7A878E"
                android:textSize="11sp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
